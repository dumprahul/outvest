# Server-only. Circle Console -> Keys -> Standard API key. Never expose to the browser.
CIRCLE_API_KEY=

# Circle Console -> Wallets -> User Controlled -> Configurator -> App ID.
# Also configure Authentication Methods -> Email (SMTP) there so OTP mail is delivered.
NEXT_PUBLIC_CIRCLE_APP_ID=

# Google OAuth Web client ID (same one saved in the Circle Configurator)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional overrides
# CIRCLE_BASE_URL=https://api.circle.com
# CIRCLE_BLOCKCHAIN=ARC-TESTNET

# Locked OutVest factory on Arc Testnet
NEXT_PUBLIC_FACTORY=
# Optional RPC override (public RPC rate-limits)
# NEXT_PUBLIC_ARC_RPC=
